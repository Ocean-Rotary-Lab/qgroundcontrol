{
  "$schema": "build-config.schema.json",
  "qt": {
    "version": "6.11.1",
    "minimum_version": "6.11.0",
    "modules": "qtgraphs qtlocation qtpositioning qtspeech qtmultimedia qtserialport qtimageformats qtshadertools qtconnectivity qtquick3d qtsensors qtscxml qtwebsockets qthttpserver"
  },
  "build": {
    "cmake_minimum_version": "3.25",
    "platform_workflows": "Linux"
  },
  "gstreamer": {
    "version": {
      "default": "1.28.4",
      "minimum": "1.20.0"
    },
    "plugins": {
      "common": [
        "app",
        "coreelements",
        "isomp4",
        "libav",
        "matroska",
        "mpegtsdemux",
        "multifile",
        "opengl",
        "openh264",
        "playback",
        "rtp",
        "rtpmanager",
        "rtsp",
        "sdpelem",
        "tcp",
        "typefindfunctions",
        "udp",
        "videoparsersbad",
        "vpx",
        "videoconvertscale",
        "videoconvert",
        "videoscale"
      ],
      "linux": [
        "nvcodec",
        "qsv",
        "va",
        "vulkan"
      ]
    }
  }
}
